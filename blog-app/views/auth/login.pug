extends ../layouts/layout

block content
  h2.mb-4 Login
  form(method="POST", action="/login")
    .mb-3
      label.form-label(for="username") Username
      input.form-control(type="text", name="username", required placeholder="Enter username")
    .mb-3
      label.form-label(for="password") Password
      input.form-control(type="password", name="password", required placeholder="Enter password")
    button.btn.btn-primary(type="submit") Login
