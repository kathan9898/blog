extends ../layouts/layout

block content
  h2.mb-4 All Blog Posts
  a.btn.btn-success.mb-4(href="/posts/new") + Create New Post

  each post in posts
    .card.mb-3
      .card-body
        h4.card-title #{post.title}
        p.card-text #{post.content}
        p.text-muted Created by #{post.createdBy.username}
        p Tags: #{post.tags.join(', ')}
        if user && user._id == post.createdBy._id.toString()
          a.btn.btn-primary.btn-sm(href=`/posts/${post._id}/edit`) Edit
          form.d-inline(method="POST", action=`/posts/${post._id}?_method=DELETE`)
            button.btn.btn-danger.btn-sm(type="submit") Delete
