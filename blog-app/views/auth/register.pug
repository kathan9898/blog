extends ../layouts/layout

block content
  h2.mb-4 Register
  form(method="POST", action="/register")
    .mb-3
      label.form-label(for="username") Username
      input.form-control(type="text", name="username", required placeholder="Choose a username")
    .mb-3
      label.form-label(for="password") Password
      input.form-control(type="password", name="password", required placeholder="Create a password")
    button.btn.btn-success(type="submit") Register
